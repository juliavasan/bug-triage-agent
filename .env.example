# Copy to .env and fill in. Never commit .env.

# GitHub personal access token, read-only (public repo access is enough).
GITHUB_TOKEN=

# OpenAI API key, used for embeddings and the chat model.
OPENAI_API_KEY=

# Optional overrides
# TRIAGE_REPO=project-chip/connectedhomeip
# TRIAGE_EMBEDDING_MODEL=text-embedding-3-small
# TRIAGE_CHAT_MODEL=gpt-4o-mini
# TRIAGE_DATA_DIR=data
